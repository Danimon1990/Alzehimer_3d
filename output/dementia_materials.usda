                    270: (0.6, 0.02, 0.02),
                    299: (0.6, 0.02, 0.02),
                    300: (0, 0, 0),
                    320: (0, 0, 0),
                }
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.58
                token outputs:surface
            }
        }
        def Material "Plaque"
