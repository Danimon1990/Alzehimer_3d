#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 0
    endTimeCode = 320
    timeCodesPerSecond = 24
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Materials"
    {
        def Material "DeadNeuron"
        {
            token outputs:surface.connect = </World/Materials/DeadNeuron/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.39, 0.28, 0.19)
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.82
                token outputs:surface
            }
        }
