#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 249
    metersPerUnit = 0.01
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Lights"
    {
        def DomeLight "Environment"
        {
            color3f inputs:color = (0.42, 0.38, 0.32)
            float inputs:intensity = 1.1
        }

        def DistantLight "Key"
        {
            color3f inputs:color = (1, 0.82, 0.58)
            float inputs:intensity = 1.4
            float3 xformOp:rotateXYZ = (-35, -25, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }
}

