#usda 1.0
(
    defaultPrim = "World"
    startTimeCode = 0
    endTimeCode = 249
    timeCodesPerSecond = 24
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Neurons"
    {
        def Xform "Neuron_01_Dead"
        {
            custom string userProperties:state = "dead"
            double3 xformOp:translate = (-18, 0, 0)
            float3 xformOp:rotateXYZ = (0, -18, 0)
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
            def Xform "NeuronAsset" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @../assets/Broken_neuron.usdc@</root>
            )
            {
                rel material:binding = </World/Materials/DeadNeuron> (bindMaterialAs = "strongerThanDescendants")
                double3 xformOp:translate = (0, 0, 0)
                float3 xformOp:rotateXYZ = (-90, 0, 0)
                float3 xformOp:scale = (2.15, 2.15, 2.15)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
            }
            def Scope "AttachmentPoints"
            {
                def Xform "AxonInterior" {}
                def Xform "AxonBreak" {}
            }
        }
        def Xform "Neuron_02_Resisting"
        {
            custom string userProperties:state = "resisting"
            double3 xformOp:translate = (18, 1.5, -1.5)
            float3 xformOp:rotateXYZ = (0, 162, 0)
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
            def Xform "NeuronAsset" (
                prepend apiSchemas = ["MaterialBindingAPI"]
                prepend references = @../assets/Sick_neuron.usdc@</root>
            )
            {
                rel material:binding = </World/Materials/ResistingNeuron> (bindMaterialAs = "strongerThanDescendants")
                double3 xformOp:translate = (0, 0, 0)
                float3 xformOp:rotateXYZ = (-90, 0, 0)
                float3 xformOp:scale = (2.15, 2.15, 2.15)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
            }
            def Scope "AttachmentPoints"
            {
                def Xform "AxonInterior" {}
                def Xform "AxonBreak" {}
            }
        }
    }
}
