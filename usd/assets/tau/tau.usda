#usda 1.0
(
    defaultPrim = "Tau"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Tau" (
    assetInfo = {
        asset identifier = @./tau.usda@
        string name = "tau"
    }
    kind = "component"
)
{
    def Xform "Geometry" (
        prepend payload = @../../../assets/TAU.usdc@</root>
    )
    {
        float xformOp:rotateX = -90
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }
}

