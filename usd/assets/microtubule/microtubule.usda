#usda 1.0
(
    defaultPrim = "Microtubule"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Microtubule" (
    assetInfo = {
        asset identifier = @./microtubule.usda@
        string name = "microtubule"
    }
    kind = "component"
)
{
    def Xform "Geometry" (
        prepend payload = @../../../assets/microtubules.usdc@</root>
    )
    {
        float xformOp:rotateX = -90
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }
}

